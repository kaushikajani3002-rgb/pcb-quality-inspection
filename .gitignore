# Python build and cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
venv/
.venv/
env/
.ipynb_checkpoints/

# Streamlit configurations
.streamlit/

# Temporary and served run files
logs/
cache/
outputs/
runs/
*.log

# VS Code / OS files
.vscode/
.DS_Store
Thumbs.db

# Large Binaries (global)
*.zip

# Local Datasets and Training Runs
Dataset/
datasets/raw/*
!datasets/raw/.gitkeep
datasets/processed/*
!datasets/processed/.gitkeep
datasets/external/*
!datasets/external/.gitkeep
datasets/samples/*
!datasets/samples/.gitkeep

# Ignore weights binaries, but track model registry configs
models/**/*.pt
models/**/*.onnx
models/**/*.engine
!models/registry.yaml
!models/**/.gitkeep

